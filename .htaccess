<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /

    # 1. Canonical: Redirect www to non-www (HTTP or HTTPS -> https://bluebasetechnologies.com)
    RewriteCond %{HTTP_HOST} ^www\.bluebasetechnologies\.com$ [NC]
    RewriteRule ^ https://bluebasetechnologies.com%{REQUEST_URI} [L,R=301,NE]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]

    # 2. Canonical: Force HTTPS on non-www
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP:CF-Visitor} !'"scheme":"https"'
    RewriteRule ^ https://bluebasetechnologies.com%{REQUEST_URI} [L,R=301,NE]

    # 3. Canonical: Redirect direct /index.php requests to clean root URL
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php[?\s] [NC]
    RewriteRule ^ https://bluebasetechnologies.com/ [L,R=301,NE]

    # 4. Canonical: Strip /public/ or /public from requested URLs
    RewriteCond %{THE_REQUEST} \s/+public/([^\s?]*) [NC]
    RewriteRule ^ https://bluebasetechnologies.com/%1 [L,R=301,NE]

    RewriteCond %{THE_REQUEST} \s/+public(?:\s|\?) [NC]
    RewriteRule ^ https://bluebasetechnologies.com/ [L,R=301,NE]

    # 5. Canonical: Redirect non-folder trailing slashes to clean URL
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^/(.+)/+$
    RewriteRule ^ https://bluebasetechnologies.com/%1 [L,R=301,NE]

    # 6. Authorization & Security Headers
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 7. Rewrite root request directly to public/index.php (prevents mod_dir redirect to /public/)
    RewriteRule ^$ public/index.php [L]

    # 8. Rewrite all remaining requests to the public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Block access to hidden and sensitive files
<FilesMatch "(^\..*|composer\.(json|lock)|package\.(json|lock)|artisan)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory browsing
Options -Indexes

